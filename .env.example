# Copy this file to an untracked local `.env.local` for development.
# Never commit a real value. Configure Production values only in Vercel.

# Public site URL — canonical URLs, sitemap, JSON-LD, RSS, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Core server runtime — required for database-backed and authenticated flows.
DATABASE_URL=
SESSION_SECRET=

# OIDC — configure only server-side values. The client secret is optional only
# when the selected provider/client configuration does not require one.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPE=openid profile email

# Newsletter — disabled unless this value is exactly `true` and a complete
# approved provider configuration is present.
NEWSLETTER_ENABLED=false
NEWSLETTER_PROVIDER=
BUTTONDOWN_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Feature gates — keep closed until their independently documented approval
# conditions are satisfied. Do not change a Production gate by copying this
# file; use the approved deployment process.
HARM_OPERATIONS_ENABLED=false
ACADEMY_ENROLLMENT_ENABLED=false
FELLOWSHIP_APPLICATIONS_ENABLED=false

# Research participation wallet — all gates remain closed by default. Real
# credentials or research data require the separate legal, privacy, security,
# and operational approvals documented in the gate register.
RESEARCH_WALLET_ENABLED=false
RESEARCH_WALLET_ARCHITECTURE_APPROVED=false
RESEARCH_WALLET_SECURITY_APPROVED=false
RESEARCH_WALLET_PRIVACY_APPROVED=false
RESEARCH_REAL_DATA_ACTIVATION_APPROVED=false
RESEARCH_WALLET_ISSUER_PRIVATE_KEY=
RESEARCH_WALLET_ISSUER_PUBLIC_KEY=
RESEARCH_VERIFIER_DATABASE_URL=
RESEARCH_VERIFIER_PEPPER=
RESEARCH_VERIFIER_CLIENTS_JSON=

# Security attribution correlation — only configure through the approved
# security-operational process; never expose this value to the client.
SECURITY_ATTRIBUTION_CORRELATION_SECRET=
